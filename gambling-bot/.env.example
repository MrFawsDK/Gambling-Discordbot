# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application ID (General Information -> Application ID), needed for npm run deploy
DISCORD_CLIENT_ID=
# Optional: deploy commands to one server only (instant updates while developing)
DEV_GUILD_ID=
# Optional: where the SQLite database is stored
# DATABASE_PATH=data/bot.db
# Optional: maximum bet per game
# MAX_BET=100000
# Optional: delete the bot's public messages after this many minutes (0 = never)
MESSAGE_TTL_MINUTES=60
