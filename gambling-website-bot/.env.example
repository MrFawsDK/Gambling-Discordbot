# Discord application (the same one as the bot is fine). OAuth2 → Client ID / Client Secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the website is reachable. Add BASE_URL/auth/callback as a redirect in the
# Discord developer portal (OAuth2 → Redirects). Use https in production.
BASE_URL=http://localhost:3000
PORT=3000

# The bot's database. Relative paths are resolved from this folder.
DATABASE_PATH=../gambling-bot/data/bot.db

# Set to 1 only behind a reverse proxy you control, so X-Forwarded-For is trusted for rate limits.
TRUST_PROXY=0

# Must match the bot's MAX_BET if you changed it there.
# MAX_BET=100000
